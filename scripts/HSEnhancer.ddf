.OPTION EXPLICIT
.Set Cabinet=ON
.Set Compress=ON
.Set CompressionType=LZX
.Set MaxDiskSize=0
.Set CabinetNameTemplate=HSEnhancer.cab
.Set DiskDirectory1=release_files
.Set GenerateInf=OFF
.Set RptFileName=NUL

"bin\HSEnhancer.dll" HSEnhancer.dll
"bin\winmm.dll" winmm.dll
"bin\main.dll" main.dll
"Manual_Install.txt" README.txt
