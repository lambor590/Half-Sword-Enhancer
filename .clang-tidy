Checks: >-
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  performance-*,
  modernize-use-override,
  modernize-use-nullptr,
  modernize-use-auto,
  misc-unused-using-decls,
  readability-identifier-naming

WarningsAsErrors: '*'

HeaderFilterRegex: '(Mod|Launcher|Proxy)/(include|src)/.*'

CheckOptions:
  # Classes / Structs — PascalCase
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase

  # Enums / Enum values — PascalCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase

  # Methods / Functions — PascalCase
  - key: readability-identifier-naming.FunctionCase
    value: CamelCase
  - key: readability-identifier-naming.MethodCase
    value: CamelCase

  # Member variables — camelCase
  - key: readability-identifier-naming.MemberCase
    value: camelBack

  # Local variables / Params — camelCase
  - key: readability-identifier-naming.LocalVariableCase
    value: camelBack
  - key: readability-identifier-naming.ParameterCase
    value: camelBack

  # Compile-time constants — UPPER_SNAKE_CASE
  - key: readability-identifier-naming.ConstexprVariableCase
    value: UPPER_CASE
  - key: readability-identifier-naming.StaticConstantCase
    value: UPPER_CASE

  # Namespaces — PascalCase
  - key: readability-identifier-naming.NamespaceCase
    value: CamelCase

  # Ignore SDK forward declarations (A*_BP_C, U*_C, etc.)
  - key: readability-identifier-naming.ClassIgnoredRegexp
    value: '^(A|U|F|S)[A-Z].*_(C|BP_C)$'
  - key: readability-identifier-naming.StructIgnoredRegexp
    value: '^(F|S)[A-Z].*_(C|BP_C)$'

  # Ignore ImGui extern API functions
  - key: readability-identifier-naming.FunctionIgnoredRegexp
    value: '^ImGui_'
  - key: readability-identifier-naming.GlobalFunctionIgnoredRegexp
    value: '^ImGui_'
