<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{4840bee3-f9e3-4821-9336-bf0ce8b83c2f}</ProjectGuid>
    <RootNamespace>Proxy</RootNamespace>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
    <Import Project="$(VCTargetsPath)\BuildCustomizations\masm.props" />
  </ImportGroup>
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup>
    <IntDir>$(SolutionDir)bin\intermediate\$(TargetName)\$(Configuration)\</IntDir>
    <TargetName>winmm</TargetName>
    <IncludePath>$(ProjectDir)include;$(IncludePath)</IncludePath>
    <SourcePath>$(ProjectDir)src</SourcePath>
    <LinkIncremental>false</LinkIncremental>
    <GeneratedExportsDir>$(IntDir)generated\</GeneratedExportsDir>
    <GeneratedExportsHeader>$(GeneratedExportsDir)winmm_exports.generated.h</GeneratedExportsHeader>
    <GeneratedExportsAsm>$(GeneratedExportsDir)winmm_exports.generated.inc</GeneratedExportsAsm>
    <GeneratedModuleDefinition>$(GeneratedExportsDir)winmm.generated.def</GeneratedModuleDefinition>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(GeneratedExportsDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions Condition="'$(IsDebugBuild)'=='true'">_DEBUG;_WINDOWS;_USRDLL;NOMINMAX;WIN32_LEAN_AND_MEAN;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(IsReleaseBuild)'=='true'">NDEBUG;_WINDOWS;_USRDLL;NOMINMAX;WIN32_LEAN_AND_MEAN;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <EnableUAC>false</EnableUAC>
      <ImportLibrary>NULL</ImportLibrary>
      <ModuleDefinitionFile>$(GeneratedModuleDefinition)</ModuleDefinitionFile>
      <AdditionalOptions>/NOEXP /NOIMPLIB %(AdditionalOptions)</AdditionalOptions>
    </Link>
    <MASM>
      <IncludePaths>$(GeneratedExportsDir);%(IncludePaths)</IncludePaths>
    </MASM>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="src\DllMain.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="resource\Proxy.rc" />
  </ItemGroup>
  <ItemGroup>
    <MASM Include="src\trampolines.asm">
      <AdditionalDependencies>$(GeneratedExportsAsm);%(AdditionalDependencies)</AdditionalDependencies>
    </MASM>
  </ItemGroup>
  <ItemGroup>
    <None Include="src\winmm.def" />
    <None Include="tools\GenerateWinmmExports.ps1" />
  </ItemGroup>
  <Target Name="GenerateAndVerifyWinmmExports" BeforeTargets="PrepareForBuild"
          Inputs="$(ProjectDir)src\winmm.def;$(ProjectDir)tools\GenerateWinmmExports.ps1"
          Outputs="$(GeneratedExportsHeader);$(GeneratedExportsAsm);$(GeneratedModuleDefinition)">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)tools\GenerateWinmmExports.ps1&quot; -DefinitionFile &quot;$(ProjectDir)src\winmm.def&quot; -CppOutput &quot;$(GeneratedExportsHeader)&quot; -AsmOutput &quot;$(GeneratedExportsAsm)&quot; -ModuleDefinitionOutput &quot;$(GeneratedModuleDefinition)&quot;" />
    <Touch Files="$(GeneratedExportsHeader);$(GeneratedExportsAsm);$(GeneratedModuleDefinition)" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
    <Import Project="$(VCTargetsPath)\BuildCustomizations\masm.targets" />
  </ImportGroup>
</Project>
